<%- include('./partials/header') %>

<section class="trips-hero">
    <h1>Learn about our trips</h1>
    <p>
        Explore the physical trips that power scenic the trips across the Kizuna Rail network.
    </p>
</section>

<section class="trips-catalog">
    <div class="trips-state" id="trips-loading">Loading trips...</div>
    <div class="trips-state trips-error" id="trips-error" hidden></div>

    <div class="trips-grid" id="trips-list"></div>

    <template id="trip-card-template">
        <article class="trip-card">
            <div class="train-image-wrap">
                <img data-field="image" loading="lazy" decoding="async">
            </div>
            
            <!-- Grid Area: header -->
            <header class="route-header">
                <h2 class="route-name" data-field="name"></h2>
                <span class="route-region" data-field="region"></span>
                <span class="route-route" data-field="route"></span>
            </header>
            
            <!-- Grid Area: station -->
            <div class="station-info">
                <div class="station">
                    <span class="station-type">From</span>
                    <span class="station-name" data-field="origin"></span>
                </div>
                <span class="route-arrow" aria-hidden="true">&rarr;</span>
                <div class="station">
                    <span class="station-type">To</span>
                    <span class="station-name" data-field="destination"></span>
                </div>
            </div>
            
            <!-- Grid Area: details -->
            <div class="route-details">
                <div class="detail-item">
                    <span class="detail-icon" aria-hidden="true">&#9201;</span>
                    <span>
                        <span class="detail-label">Duration:</span>
                        <span data-field="duration"></span>
                    </span>
                </div>
                <div class="detail-item">
                    <span class="detail-icon" aria-hidden="true">&#128207;</span>
                    <span>
                        <span class="detail-label">Distance:</span>
                        <span data-field="distance"></span>
                    </span>
                </div>
                <div class="detail-item">
                    <!-- JS should append season modifier class here: season-spring | season-summer | season-autumn | season-winter -->
                    <span class="season-badge" data-field="bestSeason"></span>
                </div>
            </div>
            
            <!-- Grid Area: description -->
            <p class="route-description" data-field="description"></p>
            
            <!-- Grid Area: highlights -->
            <div class="highlights">
                <!-- JS should populate this container with <span class="highlight-tag">Tag</span> elements -->
                <div class="highlights-list" data-field="highlights"></div>
            </div>
            
            <!-- Grid Area: actions -->
            <div class="route-actions">
                <a class="view-details-btn" data-field="details-link">View Trip Details</a>
            </div>
        </article>
    </template>
</section>

<%- include('./partials/footer') %>
