
<%- include('./partials/header') %>

<main class="bookings-admin">
    <h1>Bookings Administration</h1>

    <p id="booking-status" aria-live="polite">
        Loading bookings...
    </p>

    <div id="bookings-container"></div>

    <div class="pagination-controls">
        <button
            type="button"
            id="previous-page"
            disabled
        >
            Previous
        </button>

        <span id="page-information">
            Page 1
        </span>

        <button
            type="button"
            id="next-page"
            disabled
        >
            Next
        </button>
    </div>
</main>

<template id="booking-template">
    <article class="booking-card">
        <h3 class="passenger-name"></h3>
        <p class="passenger-email"></p>
        <p class="passenger-phone"></p>
        <p class="ticket-class"></p>
        <p class="booking-date"></p>
    </article>
</template>

<script>
    const container = document.getElementById(
        "bookings-container"
    );

    const template = document.getElementById(
        "booking-template"
    );

    const status = document.getElementById(
        "booking-status"
    );

    const previousButton = document.getElementById(
        "previous-page"
    );

    const nextButton = document.getElementById(
        "next-page"
    );

    const pageInformation = document.getElementById(
        "page-information"
    );

    let currentPage = 1;
    const limit = 10;

    async function loadBookings(page = 1) {
        status.textContent = "Loading bookings...";
        container.replaceChildren();

        try {
            const response = await fetch(
                `/api/bookings?page=${page}&limit=${limit}`
            );

            if (!response.ok) {
                throw new Error("Unable to retrieve bookings.");
            }

            const result = await response.json();

            currentPage = result.pagination.page;

            if (result.data.length === 0) {
                status.textContent = "No bookings found.";
            } else {
                status.textContent =
                    `Showing ${result.data.length} of ${result.pagination.totalItems} bookings.`;
            }

            result.data.forEach((booking) => {
                const card = template.content.cloneNode(true);

                const passengers = booking.passengers || [];

                const passengerNames = passengers.length
                    ? passengers.map(p =>
                        `${p.firstName || ""} ${p.lastName || ""}`.trim()
                    ).join(", ")
                    : `${booking.passengerFirstName || ""} ${booking.passengerLastName || ""}`.trim();

                const passengerEmails = passengers.length
                    ? passengers.map(p => p.email).filter(Boolean).join(", ")
                    : booking.passengerEmail || "Not provided";

                const passengerPhones = passengers.length
                    ? passengers.map(p => p.phone).filter(Boolean).join(", ")
                    : booking.passengerPhone || "Not provided";

                card.querySelector(".passenger-name").textContent =
                    `Passengers: ${passengerNames || "Not provided"}`;

                card.querySelector(".passenger-email").textContent =
                    `Email: ${passengerEmails}`;

                card.querySelector(".passenger-phone").textContent =
                    `Phone: ${passengerPhones}`;

                card.querySelector(".ticket-class").textContent =
                    `Ticket Class: ${booking.ticketClass || "Not recorded"}`;

                card.querySelector(".booking-date").textContent =
                    `Date: ${booking.createdAt
                        ? new Date(booking.createdAt).toLocaleString()
                        : "Not available"}`;

                container.appendChild(card);
            });

            pageInformation.textContent =
                `Page ${result.pagination.page} of ${result.pagination.totalPages}`;

            previousButton.disabled =
                !result.pagination.hasPreviousPage;

            nextButton.disabled =
                !result.pagination.hasNextPage;

        } catch (error) {
            console.error(error);
            status.textContent = "Unable to load bookings.";
        }
    }

    previousButton.addEventListener("click", () => {
        if (currentPage > 1) {
            loadBookings(currentPage - 1);
        }
    });

    nextButton.addEventListener("click", () => {
        loadBookings(currentPage + 1);
    });

    loadBookings();
</script>

<%- include('./partials/footer') %>

