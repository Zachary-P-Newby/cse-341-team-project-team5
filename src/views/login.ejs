<!--login.ejs-->
<%- include('./partials/header') %>

<div >
    <section>
        <h1>Login:</h1>
    </section>
    

    <div class="form-container">
        <form id="login-form" action="login" method="post">
            <label for="email" aria-label="email">Email:</label>
            <input type="text" name="email" id="email" maxlength="250" minlength="5" class="email-input">

            <label for="password" aria-label="password">Password:</label>
            <input type="password" name="password" id="password" class="password-input">
            
            <label for="submit-button" aria-label="submit-button">Submit:</label>
            <button id="login-form-submit-btn" class="form-submit-btn" name="submit-button">Join</button>
        </form>
    </div>
    
</div>
<%- include('./partials/footer') %>
