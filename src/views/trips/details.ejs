<%- include('../partials/header') %>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= trip.name %></h1>
            <p class="route-description"><%= trip.description %></p>
            
            <% if (trip.highlights && trip.highlights.length > 0) { %>
            <div class="highlights">
                <% trip.highlights.forEach(function(highlight) { %>
                <span class="highlight-tag"><%= highlight %></span>
                <% }); %>
            </div>
            <% } %>
        </div>
        
        <% if (trip.imageUrl) { %>
        <div class="route-image">
            <img src="<%= trip.imageUrl %>" alt="<%= trip.name %>">
        </div>
        <% } %>
    </div>

    <div class="route-info">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Region</span>
                <span class="info-value region-<%= trip.region %>"><%= trip.region.charAt(0).toUpperCase() + trip.region.slice(1) %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Duration</span>
                <span class="info-value"><%= trip.duration %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Distance</span>
                <span class="info-value"><%= trip.distance %> km</span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Best Season</span>
                <span class="info-value season-<%= trip.bestSeason %>"><%= trip.bestSeason.charAt(0).toUpperCase() + trip.bestSeason.slice(1) %></span>
            </div>
        </div>

        <div class="route-stations">
            <h2>Trip</h2>
            <div class="stations">
                <div class="station">
                    <span class="station-label">Start</span>
                    <span class="station-name"><%= trip.startStation.charAt(0).toUpperCase() + trip.startStation.slice(1) %></span>
                </div>
                <div class="station">
                    <span class="station-label">End</span>
                    <span class="station-name"><%= trip.endStation.charAt(0).toUpperCase() + trip.endStation.slice(1) %></span>
                </div>
            </div>
        </div>

        <div class="route-operating">
            <h2>Operating Schedule</h2>
            <div class="months-grid">
                <% trip.operatingMonths.forEach(function(month) { %>
                <span class="month-badge"><%= month %></span>
                <% }); %>
            </div>
        </div>

        <% if (trip.schedules && trip.schedules.length > 0) { %>
        <div class="route-schedules">
            <h2>Available Schedules</h2>
            <div class="schedules-grid">
                <% trip.schedules.forEach(function(schedule) { %>
                <div class="schedule-card">
                    <div class="schedule-times">
                        <div class="time-block">
                            <span class="time-label">Departs</span>
                            <span class="time-value"><%= schedule.departureTime %></span>
                        </div>
                        <span class="time-arrow">→</span>
                        <div class="time-block">
                            <span class="time-label">Arrives</span>
                            <span class="time-value"><%= schedule.arrivalTime %></span>
                        </div>
                    </div>
                    <div class="schedule-days">
                        <% schedule.daysOfWeek.forEach(function(day) { %>
                        <span class="day-badge"><%= day.substring(0, 3) %></span>
                        <% }); %>
                    </div>
                    <a href="/trips/booking/<%= schedule.id %>" class="book-btn">Book Now</a>
                </div>
                <% }); %>
            </div>
        </div>
        <% } %>
    </div>
</article>

<%- include('../partials/footer') %>